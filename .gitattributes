* text=auto eol=lf

# Binaries go through LFS: Hugging Face's pre-receive hook rejects raw binary
# blobs, and LFS keeps clones light on both remotes.
*.jpg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Model weights are gitignored, but mark them so an accidental add is not
# line-ending mangled.
*.pt binary
